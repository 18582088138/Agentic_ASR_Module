# Agentic_ASR_Module —— 环境变量模板 / environment template
#
# 复制为 .env 后填值；.env 已在 .gitignore，不入库。
# Copy to .env and fill in. .env is gitignored.
#
# 优先级 / priority: 进程环境变量 > .env > configs/asr.yaml
#
# ⚠️ 凭证只从**本项目自己的** .env 读，不跨目录去读 Agentic_TTS_Module 的
#    TTS_API_KEY —— 那会让两个项目耦合。终端/日志/文档/截图里的密钥一律打码。

# ---- 云 API / cloud API ----------------------------------------------------
# MiniMax Speech-to-Text（POST /v1/speech_to_text，model=asr-1.0）
# 【实测】本 key 只在国内端点 api.minimaxi.com 有效；海外 api.minimax.io 返回 401。
MINIMAX_API_KEY=

# 可选：覆盖默认 endpoint
ASR_API_ENDPOINT=

# 通用 OpenAI 兼容端点（可填 OpenAI / Groq / 硅基流动 / OpenRouter）
# 例：https://api.groq.com/openai/v1  · https://api.siliconflow.cn/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=

# ---- 引擎与运行时（一般不用改，留给部署时临时覆盖）/ engine & runtime ------
# ASR_ENGINE=faster_whisper       # faster_whisper | sensevoice | minimax | openai_compat | mock
# ASR_DEVICE=cuda
# ASR_MODELS_DIR=
# ASR_OUTPUT_DIR=
# ASR_SERVER_HOST=127.0.0.1
# ASR_SERVER_PORT=8301
